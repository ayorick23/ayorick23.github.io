---
import { Icon } from "astro-icon/components";
import { navItems } from "../data/nav";
import { localizePath, type Locale } from "../lib/i18n";
import type { UICopy } from "../content/i18n/types";

interface Props {
  ui: UICopy;
  locale: Locale;
}

const { ui, locale } = Astro.props;
const homeHref = localizePath("/", locale);
const year = new Date().getFullYear();
---

<footer class="relative z-[1] mt-10 border-t border-line">
  <div
    class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] items-center gap-7 px-8 py-10"
  >
    <div>
      <div class="mb-3 font-display text-[15px] font-bold tracking-[0.14em]">DM</div>
      <p class="font-mono text-[11.5px] leading-[1.7] text-ink-3">
        {ui.footer.tagline}<br />
        {ui.footer.subtitle}<br />
        © {year} Dereck Mendez. {ui.footer.rights}
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-1.5">
      {
        navItems.map((item) => (
          <a
            href={`${homeHref}${item.href}`}
            class="px-0 py-1.5 font-display text-[12.5px] font-medium text-ink-3 transition-colors duration-200 ease-out hover:text-ink"
          >
            {ui.nav[item.id]}
          </a>
        ))
      }
      <a
        href="#"
        title={ui.footer.backToTop}
        aria-label={ui.footer.backToTop}
        class="ml-1 flex h-9 w-9 items-center justify-center rounded-full border border-line-2 text-ink-2 transition-colors duration-200 ease-out hover:border-accent hover:text-accent"
      >
        <Icon name="lucide:arrow-up" class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>
