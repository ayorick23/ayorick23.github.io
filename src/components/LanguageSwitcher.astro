---
import type { UICopy } from "../content/i18n/types";
import { getAlternatePath, type Locale } from "../lib/i18n";

interface Props {
  ui: UICopy;
  locale: Locale;
  class?: string;
}

const { ui, locale, class: className = "" } = Astro.props;
const alternatePath = getAlternatePath(Astro.url.pathname, locale);
const alternateLocale: Locale = locale === "en" ? "es" : "en";
---

<a
  href={alternatePath}
  hreflang={alternateLocale}
  data-lang-switch={alternateLocale}
  class:list={[
    "flex h-[30px] items-center rounded-full border border-line px-[10px] font-mono text-[11px] tracking-[0.08em] text-ink-2 transition-all duration-200 ease-out hover:border-line-2 hover:text-ink",
    className,
  ]}
>
  {ui.language.switchTo}
</a>
