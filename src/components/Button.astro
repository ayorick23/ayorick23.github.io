---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  class?: string;
  target?: "_blank";
}

const { href, variant = "primary", class: className = "", target } = Astro.props;
const Tag = href ? "a" : "button";
const rel = target === "_blank" ? "noopener noreferrer" : undefined;

const base =
  "inline-flex cursor-pointer items-center gap-[10px] font-display font-semibold text-[14px] px-6 py-[15px] rounded-xl transition-all duration-200 ease-out";
const variants = {
  primary:
    "bg-btn-bg text-btn-fg shadow-[0_10px_30px_-14px_rgba(91,140,255,0.5)] hover:-translate-y-0.5 hover:shadow-[0_16px_36px_-14px_rgba(91,140,255,0.6)]",
  secondary:
    "bg-veil text-ink border border-line-2 backdrop-blur-md hover:-translate-y-0.5 hover:bg-veil-2",
};
---

<Tag href={href} target={target} rel={rel} class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</Tag>
