---
import { Icon } from "astro-icon/components";
import ProjectCover from "./ProjectCover.astro";
import type { ProjectEntry } from "../lib/projects";
import { localizePath, type Locale } from "../lib/i18n";
import type { UICopy } from "../content/i18n/types";

interface Props {
  project: ProjectEntry;
  ui: UICopy;
  locale: Locale;
  index: number;
}

const { project, ui, locale, index } = Astro.props;
const href = localizePath(`/projects/${project.id}`, locale);
const num = String(index + 1).padStart(2, "0");
---

<div
  data-cover-hover-scope
  class="shadow-elevated group relative flex flex-col overflow-hidden rounded-[20px] border border-line bg-[image:var(--gradient-card)] backdrop-blur-[20px] transition-transform duration-300 ease-[cubic-bezier(.2,.7,.3,1)] hover:-translate-y-1.5 hover:border-line-2"
  style="box-shadow: var(--shadow-elevated);"
>
  <a href={href} class="absolute inset-0 z-0" aria-label={project.data.title}></a>
  <div class:list={["project-cover relative h-[172px] border-b border-line", !project.data.coverKind && "project-cover--empty"]}>
    {project.data.coverKind && <ProjectCover kind={project.data.coverKind} />}
    <span
      class="absolute right-[14px] top-[13px] font-mono text-[10px] tracking-[0.1em] text-ink-3"
    >
      {num}
    </span>
    {
      !project.data.coverKind && (
        <span class="absolute bottom-3 left-[14px] font-mono text-[9.5px] tracking-[0.14em] text-ink-3 uppercase">
          {project.data.coverImage ? ui.common.caseStudyLabel : ui.common.coverPending}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-[22px]">
    <div class="flex items-center gap-2 font-mono text-[10px] tracking-[0.18em] text-accent uppercase">
      <span>{project.data.category}</span>
      {
        project.data.status === "placeholder" && (
          <span class="rounded-full border border-dashed border-line-2 px-[8px] py-[2px] text-ink-3 normal-case tracking-[0.08em]">
            {ui.common.placeholderBadge}
          </span>
        )
      }
    </div>
    <div class="font-display text-[19px] leading-[1.25] font-semibold tracking-[-0.015em]">
      {project.data.title}
    </div>
    <p class="font-display text-[13.5px] leading-[1.7] text-ink-2">
      {project.data.shortDescription}
    </p>
    <div class="mt-1 flex flex-wrap gap-[6px]">
      {
        project.data.technologies.slice(0, 4).map((tech) => (
          <span class="rounded-[7px] border border-line bg-veil px-[9px] py-[6px] font-mono text-[10.5px] text-ink-2">
            {tech}
          </span>
        ))
      }
    </div>
    <div class="mt-auto flex items-center justify-between border-t border-line pt-[18px]">
      <span class="font-display text-[12.5px] font-medium text-ink">{ui.work.caseStudyCta} →</span>
      {
        project.data.githubUrl && (
          <a
            href={project.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={ui.common.viewOnGithub}
            title={ui.common.viewOnGithub}
            class="relative z-10 flex items-center gap-1 rounded-full border border-line-2 bg-veil px-[10px] py-[6px] text-ink-2 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-accent hover:text-accent"
          >
            <Icon name="akar-icons--github-fill" class="h-[17px] w-[17px]" />
            <Icon name="lucide:arrow-up-right" class="h-[12px] w-[12px]" />
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .project-cover {
    background: radial-gradient(120% 100% at 50% 0%, var(--surface), var(--bg));
  }
  .project-cover--empty::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(115deg, var(--line) 0 1px, transparent 1px 11px);
    opacity: 0.9;
  }
  .project-cover--empty::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 70% 30%, var(--accent-soft), transparent 70%);
  }
</style>
