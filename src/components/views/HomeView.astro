---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Constellation from "../Constellation.astro";
import ProjectGrid from "../ProjectGrid.astro";
import CapabilityCard from "../CapabilityCard.astro";
import Timeline from "../Timeline.astro";
import Button from "../Button.astro";
import { getUI, localizePath, resolveLocale } from "../../lib/i18n";
import { getFeaturedProjects } from "../../lib/projects";
import { toolGroups, exploringTools } from "../../data/tools";
import ToolChip from "../ToolChip.astro";
import { socialLinks } from "../../data/social-links";
import profilePhoto from "../../assets/images/dereck-mendez.png";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
const featuredProjects = await getFeaturedProjects(locale, 3);

const socialLabels: Record<string, string> = { github: "GitHub", linkedin: "LinkedIn", email: "Email" };
const heroSocials = socialLinks.filter((s) => s.id === "github" || s.id === "linkedin");

const toolFilters = [
  { key: "all", label: ui.tools.filterAll },
  ...toolGroups.map((g) => ({ key: g.key, label: ui.tools.groups[g.key].short })),
];
---

<section
  class="relative mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-10 px-8 pt-[150px] pb-[70px] min-h-screen md:grid-cols-[repeat(auto-fit,minmax(420px,1fr))]"
>
  <div class="hero-aurora pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="max-w-[560px]">
    <div class="mb-[26px] flex items-center gap-[10px]">
      <span
        class="h-[5px] w-[5px] rounded-full bg-accent"
        style="box-shadow: 0 0 12px var(--accent)"
      ></span>
      <span class="font-mono text-[11px] tracking-[0.26em] text-ink-2">{ui.hero.kicker}</span>
    </div>
    <h1
      class="mb-[26px] animate-[fade-up_0.6s_ease_0.15s_both] text-[clamp(2.4rem,5.4vw,4.1rem)] leading-[1.06] font-light tracking-[-0.03em] text-wrap-balance"
    >
      <span class="sr-only">Dereck Mendez — </span>{ui.hero.titleLead}{" "}
      <span class="font-semibold">{ui.hero.titleAccent}</span>{" "}
      <span class="font-semibold text-accent">{ui.hero.titleTail}</span>
    </h1>
    <p
      class="mb-[38px] max-w-[430px] animate-[fade-up_0.6s_ease_0.3s_both] text-[16.5px] leading-[1.62] text-ink-2"
    >
      {ui.hero.subtitle}
    </p>
    <div class="flex flex-wrap items-center gap-3 animate-[fade-up_0.6s_ease_0.45s_both]">
      <Button href="#work" variant="primary">
        {ui.hero.ctaPrimary} <span class="opacity-60">→</span>
      </Button>
      <Button href="#about" variant="secondary">{ui.hero.ctaSecondary}</Button>
      <div class="ml-1 flex items-center gap-[10px]">
        {
          heroSocials.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              title={socialLabels[link.id]}
              aria-label={socialLabels[link.id]}
              class="dm-hero-social flex h-11 w-11 items-center justify-center rounded-full border border-line-2 text-ink-2 transition-colors duration-200 ease-out hover:border-accent hover:text-accent"
            >
              <Icon name={link.icon} class="h-[19px] w-[19px]" />
            </a>
          ))
        }
      </div>
    </div>
    <div class="mt-16 flex items-center gap-3 animate-[fade-up_0.6s_ease_0.6s_both]">
      <span class="dm-scroll-mouse relative block h-[40px] w-[25px] shrink-0 rounded-full border border-line-2">
        <span class="absolute top-[7px] left-1/2 h-[8px] w-[4px] -translate-x-1/2 rounded-full bg-accent" style="animation: dm-scroll-dot 1.8s ease-in-out infinite"></span>
      </span>
      <span class="font-mono text-[12px] tracking-[0.16em] text-ink-3">{ui.hero.scrollHint}</span>
    </div>
  </div>

  <Constellation ui={ui} />
</section>

<section id="work" data-reveal class="mx-auto max-w-[1240px] px-8 pt-[70px] pb-10 scroll-mt-[100px]">
  <div class="mb-11 flex flex-wrap items-end justify-between gap-5">
    <div>
      <div class="mb-[18px] flex items-center gap-[9px]">
        <span class="h-1 w-1 rounded-full bg-accent"></span>
        <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.work.kicker}</span>
      </div>
      <h2 class="max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1.14] font-light tracking-[-0.025em]">
        <span class="font-semibold">{ui.work.headingLead}</span> {ui.work.headingAccent}
      </h2>
      <p class="mt-3 max-w-lg font-display text-[14.5px] leading-[1.6] text-ink-2">{ui.work.description}</p>
    </div>
    <a
      href={localizePath("/projects", locale)}
      class="inline-flex items-center gap-2 border-b border-line-2 pb-1 font-display text-[13.5px] font-medium text-ink-2 transition-all duration-200 ease-out hover:gap-3 hover:text-ink"
    >
      {ui.work.viewAll} <span>→</span>
    </a>
  </div>
  <ProjectGrid projects={featuredProjects} ui={ui} locale={locale} />
</section>

<section data-reveal data-tools-root class="mx-auto max-w-[1240px] px-8 pt-[22px] pb-[70px]">
  <div class="mb-7 flex flex-wrap items-end justify-between gap-5">
    <div>
      <div class="mb-[18px] flex items-center gap-[9px]">
        <span class="h-1 w-1 rounded-full bg-accent"></span>
        <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.tools.kicker}</span>
      </div>
      <h2 class="m-0 max-w-[520px] font-display text-[clamp(26px,3vw,36px)] leading-[1.16] font-light tracking-[-0.025em]">
        {ui.tools.headingLead} <span class="font-semibold">{ui.tools.headingAccent}</span>
      </h2>
    </div>
    <div
      role="group"
      aria-label={ui.tools.filterLabel}
      data-tools-filter
      class="dm-tools-filter relative flex max-w-full gap-1 overflow-x-auto rounded-full border border-line bg-veil p-1 backdrop-blur-[16px]"
    >
      <span data-tools-indicator aria-hidden="true" class="dm-tools-indicator"></span>
      {
        toolFilters.map((filter) => (
          <button
            type="button"
            data-tools-filter-btn={filter.key}
            aria-pressed={filter.key === "all" ? "true" : "false"}
            class="dm-tools-tab relative z-[1] shrink-0 cursor-pointer rounded-full border-0 bg-transparent px-[13px] py-[9px] font-display text-xs leading-none font-medium whitespace-nowrap"
          >
            {filter.label}
          </button>
        ))
      }
    </div>
  </div>
  <div
    data-tools-panel
    class="shadow-elevated overflow-hidden rounded-[22px] border border-line bg-[image:var(--gradient-card)] backdrop-blur-[20px]"
    style="box-shadow: var(--shadow-elevated);"
  >
    {
      toolGroups.map((group, gi) => (
        <div data-tool-group={group.key} class="dm-tool-group">
          <div class="min-h-0 overflow-hidden">
            <div class="dm-tool-row grid grid-cols-1 items-center gap-x-9 gap-y-[18px] px-7 py-[26px] transition-colors duration-300 hover:bg-veil lg:grid-cols-[minmax(240px,330px)_1fr]">
              <div class="flex items-start gap-4">
                <span class="dm-tool-dot mt-[6px] h-[7px] w-[7px] shrink-0 rounded-full border border-accent bg-bg" />
                <div>
                  <div class="mb-[7px] flex items-baseline gap-[10px]">
                    <span class="font-mono text-[10.5px] leading-none text-ink-3">{String(gi + 1).padStart(2, "0")}</span>
                    <h3 class="m-0 font-display text-base leading-[1.25] font-semibold text-ink">
                      {ui.tools.groups[group.key].name}
                    </h3>
                  </div>
                  <p class="m-0 font-display text-[13px] leading-normal text-ink-2">
                    {ui.tools.groups[group.key].description}
                  </p>
                </div>
              </div>
              <div class="flex min-w-0 flex-wrap gap-2">
                {group.tools.map((tool) => (
                  <ToolChip tool={tool} />
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  {
    exploringTools.length > 0 && (
      <div class="mt-[22px] flex flex-wrap items-center gap-[14px] rounded-[14px] border border-line bg-veil px-5 py-4 backdrop-blur-[16px]">
        <span class="font-mono text-[10px] tracking-[0.2em] text-accent-2 uppercase">{ui.tools.exploringLabel}</span>
        <div class="flex flex-wrap gap-2">
          {exploringTools.map((tool) => (
            <ToolChip tool={tool} dashed />
          ))}
        </div>
      </div>
    )
  }
</section>

<section id="about" data-reveal class="mx-auto max-w-[1240px] px-8 py-[60px] scroll-mt-[100px]">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-center gap-11 lg:grid-cols-[1fr_37%]">
    <div class="max-w-[660px]">
      <div class="mb-[18px] flex items-center gap-[9px]">
        <span class="h-1 w-1 rounded-full bg-accent-2"></span>
        <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.about.kicker}</span>
      </div>
      <h2 class="mb-6 font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1.14] font-light tracking-[-0.025em]">
        {ui.about.headingLead} <span class="font-semibold">{ui.about.headingAccent}</span>
      </h2>
      {ui.about.previewParagraphs.map((p) => (
        <p class="mb-4 font-display text-[15.5px] leading-[1.68] text-ink-2">{p}</p>
      ))}
      <Button href={localizePath("/about", locale)} variant="secondary" class="mt-4">
        {ui.about.moreLink} <span class="opacity-50">→</span>
      </Button>
    </div>
    <div class="flex items-center justify-center py-6">
      <div class="relative h-[280px] w-[280px]">
        <svg
          class="dm-photo-arc pointer-events-none absolute -inset-[14px] h-[calc(100%+28px)] w-[calc(100%+28px)]"
          viewBox="0 0 100 100"
          aria-hidden="true"
        >
          <circle
            cx="50"
            cy="50"
            r="48"
            fill="none"
            stroke="var(--accent)"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-dasharray="70 240"
            transform="rotate(-55 50 50)"
          />
        </svg>

        <div
          class="shadow-elevated relative h-full w-full overflow-hidden rounded-full border border-line-2"
          style="box-shadow: var(--shadow-elevated);"
        >
          <Image
            src={profilePhoto}
            alt="Dereck Mendez"
            width={560}
            height={560}
            class="h-full w-full object-cover"
            style="filter: var(--photo-filter); object-position: 50% 18%"
          />
        </div>

        <div
          class="dm-photo-badge absolute -top-3 -left-5 flex h-[52px] w-[52px] items-center justify-center rounded-full border border-line-2 bg-veil-2 text-ink-2 backdrop-blur-[10px]"
          style="box-shadow: var(--shadow-elevated); animation-delay: 0.9s; rotate: -10deg"
          title="Python"
          aria-hidden="true"
        >
          <Icon name="simple-icons--python" class="h-[26px] w-[26px]" />
        </div>
        <div
          class="dm-photo-badge absolute -right-5 bottom-3 flex h-12 w-12 items-center justify-center rounded-full border border-line-2 bg-veil-2 text-ink-2 backdrop-blur-[10px]"
          style="box-shadow: var(--shadow-elevated); animation-delay: 0s; rotate: 8deg"
          title="Pandas"
          aria-hidden="true"
        >
          <Icon name="devicon-plain--pandas" class="h-6 w-6" />
        </div>

        <div
          class="absolute -bottom-9 left-0 w-[196px] rounded-[16px] border border-line bg-[image:var(--gradient-card)] px-4 py-3 backdrop-blur-[18px]"
          style="box-shadow: var(--shadow-elevated);"
        >
          <div class="font-display text-[22px] leading-none font-light tracking-[-0.02em]">{ui.about.stats[0].value}</div>
          <div class="mt-1 font-display text-[11px] leading-[1.4] text-ink-2">{ui.about.stats[0].label}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="experience" data-reveal class="mx-auto max-w-[1240px] px-8 py-[70px] scroll-mt-[100px]">
  <div class="mb-[18px] flex items-center gap-[9px]">
    <span class="h-1 w-1 rounded-full bg-accent"></span>
    <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.experience.kicker}</span>
  </div>
  <div class="mb-3 flex flex-wrap items-end justify-between gap-4">
    <h2 class="font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1.14] font-light tracking-[-0.025em]">
      {ui.experience.headingLead} <span class="font-semibold">{ui.experience.headingAccent}</span>{" "}
      {ui.experience.headingTail}
    </h2>
    <a
      href={localizePath("/experience", locale)}
      class="inline-flex items-center gap-2 border-b border-line-2 pb-1 font-display text-[13.5px] font-medium text-ink-2 transition-all duration-200 ease-out hover:gap-3 hover:text-ink"
    >
      {ui.experience.viewFull} <span>→</span>
    </a>
  </div>
  {ui.experience.note && <p class="mb-[46px] font-mono text-[12px] text-ink-3">{ui.experience.note}</p>}
  <div class={ui.experience.note ? "" : "mt-[46px]"}>
    <Timeline entries={ui.experience.timeline.slice(0, 2)} />
  </div>
</section>

<section id="skills" data-reveal class="mx-auto max-w-[1240px] px-8 py-[60px] scroll-mt-[100px]">
  <div class="mb-[18px] flex items-center gap-[9px]">
    <span class="h-1 w-1 rounded-full bg-accent-2"></span>
    <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.capabilities.kicker}</span>
  </div>
  <h2 class="mb-[46px] max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1.14] font-light tracking-[-0.025em]">
    {ui.capabilities.headingLead} <span class="font-semibold">{ui.capabilities.headingAccent}</span>
  </h2>
  <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[20px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    {ui.capabilities.items.map((cap, i) => (
      <CapabilityCard index={i} title={cap.title} description={cap.description} />
    ))}
  </div>
</section>

<section id="contact" data-reveal class="mx-auto max-w-[1240px] px-8 pt-[60px] pb-10 scroll-mt-[100px]">
  <div
    class="shadow-elevated relative overflow-hidden rounded-[26px] border border-line bg-[image:var(--gradient-card)] p-[clamp(2.4rem,6vw,4.75rem)] backdrop-blur-[24px]"
    style="box-shadow: var(--shadow-elevated);"
  >
    <div data-nebula class="pointer-events-auto absolute inset-0">
      <canvas data-nebula-canvas aria-hidden="true" class="absolute inset-0 h-full w-full"></canvas>
    </div>
    <div class="relative max-w-[560px]">
      <h2 class="mb-5 font-display text-[clamp(1.9rem,4.2vw,3.1rem)] leading-[1.1] font-light tracking-[-0.03em]">
        {ui.contact.headingLead} <span class="font-semibold text-accent">{ui.contact.headingAccent}</span>
      </h2>
      <p class="mb-3 max-w-[460px] font-display text-[15.5px] leading-[1.65] text-ink-2">{ui.contact.subtitle}</p>
      <p class="mb-[34px] max-w-[460px] font-display text-[15.5px] leading-[1.65] text-ink-2">{ui.contact.description}</p>
      <div class="grid w-fit gap-[10px] sm:grid-flow-col sm:auto-cols-fr">
        <Button href={`mailto:${socialLinks.find((s) => s.id === "email")?.href.replace("mailto:", "")}`} variant="primary" class="justify-center">
          {ui.contact.cta} <span class="opacity-55">→</span>
        </Button>
        {socialLinks.filter((s) => s.id !== "email").map((link) => (
          <Button href={link.href} variant="secondary" target="_blank" class="justify-center">
            <Icon name={link.icon} class="h-[15px] w-[15px]" />
            {socialLabels[link.id]} <span class="text-[11px] text-ink-3">↗</span>
          </Button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initConstellation } from "../../scripts/constellation";
  import { initNebula } from "../../scripts/nebula";
  import { initToolsFilter } from "../../scripts/tools";
  document.addEventListener("astro:page-load", initConstellation);
  document.addEventListener("astro:page-load", initNebula);
  document.addEventListener("astro:page-load", initToolsFilter);
</script>

<style>
  /* Only defined under [data-theme="light"] in global.css — stays invisible in dark mode. */
  .hero-aurora {
    background: var(--gradient-aurora, none);
    filter: blur(50px);
  }

  /* About photo — same float/glow language as the hero social icons. */
  .dm-photo-arc {
    opacity: 0.8;
  }
  .dm-photo-badge {
    animation:
      var(--animate-float),
      dm-star-glow 3.2s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .dm-photo-badge {
      animation: none;
    }
  }
</style>
