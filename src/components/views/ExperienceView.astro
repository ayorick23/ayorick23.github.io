---
import Timeline from "../Timeline.astro";
import { getUI, localizePath, resolveLocale } from "../../lib/i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
const homeHref = localizePath("/", locale);
---

<section class="mx-auto max-w-[1100px] px-8 pt-[150px] pb-[70px]">
  <a
    href={homeHref}
    class="mb-[38px] inline-flex items-center gap-2 font-mono text-[12px] text-ink-3 transition-colors duration-200 ease-out hover:text-ink"
  >
    ← {ui.common.backToHome}
  </a>
  <div class="mb-[18px] flex items-center gap-[9px]">
    <span class="h-1 w-1 rounded-full bg-accent"></span>
    <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{ui.experience.kicker}</span>
  </div>
  <h1 class="mb-[46px] font-display text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-light tracking-[-0.03em]">
    {ui.experience.headingLead} <span class="font-semibold">{ui.experience.headingAccent}</span>{" "}
    {ui.experience.headingTail}
  </h1>
  {ui.experience.note && <p class="mb-[46px] font-mono text-[12px] text-ink-3">{ui.experience.note}</p>}
  <Timeline entries={ui.experience.timeline} />
</section>
