---
import { Icon } from "astro-icon/components";
import type { TimelineEntry } from "../content/i18n/types";
import { certificates } from "../data/certificates";
import { formatYearMonth, monthIndex } from "../lib/dates";
import {
  currentMonth,
  formatDuration,
  formatRange,
  studyEnd,
  studyPrograms,
  toRoles,
} from "../lib/experience";
import { getUI, resolveLocale } from "../lib/i18n";

interface Props {
  entries: TimelineEntry[];
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
const chart = ui.experience.chart;
const edu = ui.about.education;

/* Roles shorter than this always carry their name outside the bar: a name that only
   just fits reads cramped. */
const SHORT_ROLE_MONTHS = 18;

// Oldest first, like reading a Gantt left to right / top to bottom.
const roles = toRoles(Astro.props.entries).sort((a, b) => a.from - b.from);
const now = currentMonth();

const firstYear = Math.floor(roles[0].from / 12);
const lastYear = Math.floor(Math.max(studyEnd, now) / 12);
const min = firstYear * 12;
const max = (lastYear + 1) * 12;
const pct = (m: number) => ((m - min) / (max - min)) * 100;
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);

// Certificates are grouped by quarter: one month apart is only ~8px on the axis.
const quarters = new Map<number, typeof certificates>();
for (const cert of certificates) {
  const q = Math.floor(monthIndex(cert.issued) / 3);
  quarters.set(q, [...(quarters.get(q) ?? []), cert]);
}
const certGroups = [...quarters.entries()]
  .sort(([a], [b]) => a - b)
  .map(([q, list]) => ({ at: pct(q * 3 + 1.5), list: [...list].sort((a, b) => b.issued.localeCompare(a.issued)) }));
---

<div data-gantt data-min={min} data-max={max} class="dm-gantt relative">
  <div data-gantt-scroll class="dm-gantt__scroll">
    <div class="dm-gantt__chart">
      <div class="dm-gantt__grid" aria-hidden="true">
        {
          years.map((y) => (
            <div class="dm-gantt__year" style={`left: ${pct(y * 12)}%`}>
              <span>{y}</span>
            </div>
          ))
        }
        <div data-gantt-today class="dm-gantt__today" style={`left: ${pct(now)}%`}>
          <span>{chart.today}</span>
        </div>
      </div>

      <div class="dm-gantt__lane-label">{chart.workLane}</div>
      {
        roles.map((role, i) => (
          <div class="dm-gantt__row">
            <button
              type="button"
              data-gantt-bar
              data-from={role.from}
              data-current={role.isCurrent ? "" : undefined}
              data-outside={role.to - role.from < SHORT_ROLE_MONTHS ? "" : undefined}
              class:list={["dm-gantt__bar", role.isCurrent && "is-current", pct(role.from) > 50 && "is-late"]}
              style={`left: ${pct(role.from)}%; width: ${pct(role.to) - pct(role.from)}%; --i: ${i}`}
            >
              <span data-gantt-label class="dm-gantt__label">
                {role.role}
              </span>
              <span data-gantt-detail hidden>
                <span class="dm-gantt__tip-kicker">{formatRange(role, locale, chart.today)}</span>
                <span class="dm-gantt__tip-title">{role.role}</span>
                <span class="dm-gantt__tip-org">
                  {role.org} · {formatDuration(role.to - role.from, chart.units)}
                </span>
                <span class="dm-gantt__tip-body">{role.summary}</span>
              </span>
            </button>
          </div>
        ))
      }

      <div class="dm-gantt__lane-label is-gap">{chart.studyLane}</div>
      {
        studyPrograms.map((program, i) => {
          const name = program.id === "technician" ? edu.milestones.technician.detail : edu.degree;
          const done = Math.min(100, Math.max(0, ((now - program.from) / (program.to - program.from)) * 100));
          return (
            <div class="dm-gantt__row">
              <button
                type="button"
                data-gantt-bar
                class:list={["dm-gantt__bar is-study", pct(program.from) > 50 && "is-late"]}
                style={`left: ${pct(program.from)}%; width: ${pct(program.to) - pct(program.from)}%; --i: ${roles.length + i}; --done: ${done}%`}
              >
                <span data-gantt-label class="dm-gantt__label">{name}</span>
                <span data-gantt-detail hidden>
                  <span class="dm-gantt__tip-kicker">{edu.institution}</span>
                  <span class="dm-gantt__tip-title">{name}</span>
                  <span class="dm-gantt__tip-org">
                    {formatYearMonth(program.start, locale)} – {formatYearMonth(program.end, locale, program.yearOnly)}
                    {" · "}
                    {program.to > now ? edu.status : chart.finished}
                  </span>
                </span>
              </button>
            </div>
          );
        })
      }

      <div class="dm-gantt__lane-label is-gap">{chart.certLane} · {certificates.length}</div>
      <div class="dm-gantt__row is-certs">
        {
          certGroups.map((group) => (
            <button
              type="button"
              data-gantt-bar
              class="dm-gantt__cert"
              style={`left: ${group.at}%; --size: ${8 + Math.min(group.list.length, 4) * 3}px`}
              aria-label={`${group.list.length} ${chart.certificates}`}
            >
              {group.list.length > 1 && <span class="dm-gantt__cert-count">{group.list.length}</span>}
              <span data-gantt-detail hidden>
                <span class="dm-gantt__tip-kicker">
                  {group.list.length} {chart.certificates}
                </span>
                <span class="dm-gantt__tip-list">
                  {group.list.map((cert) => (
                    <span class="dm-gantt__tip-item">
                      <span class="dm-gantt__tip-date">{formatYearMonth(cert.issued, locale)}</span>
                      {cert.title[locale]} <em>· {cert.issuer}</em>
                    </span>
                  ))}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div data-gantt-tip class="dm-gantt__tip" role="tooltip" hidden></div>

  <p class="mt-5 flex items-center gap-2 font-mono text-[11.5px] text-ink-3">
    <Icon name="lucide:mouse-pointer-click" class="h-[14px] w-[14px]" aria-hidden="true" />
    {chart.hint}
  </p>
</div>

<script>
  import { initGantt } from "../scripts/gantt";
  document.addEventListener("astro:page-load", initGantt);
</script>

<style>
  .dm-gantt__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    padding-bottom: 6px;
  }
  .dm-gantt__chart {
    position: relative;
    min-width: 760px;
    padding: 30px 0 40px;
  }

  .dm-gantt__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .dm-gantt__year {
    position: absolute;
    top: 22px;
    bottom: 22px;
    border-left: 1px dashed var(--line-2);
  }
  .dm-gantt__year span {
    position: absolute;
    bottom: -22px;
    left: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .dm-gantt__today {
    position: absolute;
    top: 0;
    bottom: 22px;
    width: 0;
    border-left: 1.5px solid var(--accent);
    z-index: 2;
  }
  .dm-gantt__today span {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dm-gantt__lane-label {
    position: relative;
    height: 26px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 26px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line-2);
  }
  .dm-gantt__lane-label.is-gap {
    margin-top: 14px;
  }

  .dm-gantt__row {
    position: relative;
    height: 44px;
  }
  .dm-gantt__bar {
    position: absolute;
    top: 6px;
    height: 32px;
    min-width: 10px;
    border-radius: 11px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    text-align: left;
    cursor: pointer;
    transform-origin: left center;
    transform: scaleX(0);
    transition:
      transform 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) calc(var(--i) * 0.08s + 0.15s),
      opacity 0.25s ease;
    z-index: 1;
  }
  :global([data-reveal].is-visible) .dm-gantt__bar {
    transform: scaleX(1);
  }
  .dm-gantt__bar.is-current {
    background: var(--accent);
    color: #fff;
  }
  /* Done part solid, planned part as a hatched outline. */
  .dm-gantt__bar.is-study {
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--ink) 16%, transparent) var(--done),
        transparent var(--done)
      ),
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--ink) 7%, transparent) 0 6px,
        transparent 6px 12px
      );
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--ink);
  }
  .dm-gantt__label {
    display: block;
    overflow: hidden;
    padding: 0 12px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    line-height: 32px;
    white-space: nowrap;
  }
  /* When the role name doesn't fit, it moves out to the right of its bar (each
     row only holds one bar, so that space is always free). */
  .dm-gantt__bar.is-outside .dm-gantt__label {
    position: absolute;
    left: 100%;
    top: 0;
    overflow: visible;
    padding-left: 10px;
    color: var(--ink-2);
    font-weight: 500;
  }
  .dm-gantt__bar.is-outside.is-left .dm-gantt__label {
    left: auto;
    right: 100%;
    padding: 0 10px 0 0;
  }

  .dm-gantt__cert {
    position: absolute;
    top: 50%;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--btn-bg);
    transform: translate(-50%, -50%) scale(0);
    transition:
      transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) 1s,
      opacity 0.25s ease;
    cursor: pointer;
  }
  :global([data-reveal].is-visible) .dm-gantt__cert {
    transform: translate(-50%, -50%) scale(1);
  }
  .dm-gantt__cert-count {
    position: absolute;
    bottom: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
  }

  .dm-gantt.is-hovering .dm-gantt__bar:not(.is-active),
  .dm-gantt.is-hovering .dm-gantt__cert:not(.is-active) {
    opacity: 0.35;
  }
  .dm-gantt__bar:focus-visible,
  .dm-gantt__cert:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .dm-gantt__tip {
    position: absolute;
    z-index: 20;
    width: min(340px, calc(100% - 16px));
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-elevated);
    padding: 14px 16px;
    pointer-events: none;
    animation: dm-gantt-tip 0.18s ease-out;
  }
  @keyframes dm-gantt-tip {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .dm-gantt__tip :global(.dm-gantt__tip-kicker) {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-title) {
    display: block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-org) {
    display: block;
    margin-top: 2px;
    font-family: var(--font-display);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-body) {
    display: block;
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-list) {
    display: grid;
    gap: 7px;
    margin-top: 10px;
  }
  .dm-gantt__tip :global(.dm-gantt__tip-item) {
    display: block;
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-item.is-planned) {
    color: var(--ink-3);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-item em) {
    font-style: normal;
    color: var(--ink-3);
  }
  .dm-gantt__tip :global(.dm-gantt__tip-date) {
    display: inline-block;
    min-width: 72px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
  }

  /* Phones: no horizontal scroll. Bars thin out and each name sits above its bar,
     hanging from the bar's end when the bar is in the right half. */
  @media (max-width: 639px) {
    .dm-gantt__chart {
      min-width: 0;
    }
    .dm-gantt__row {
      height: 46px;
    }
    .dm-gantt__bar {
      top: 26px;
      height: 12px;
      min-width: 6px;
      border-radius: 5px;
    }
    .dm-gantt__label {
      position: absolute;
      bottom: calc(100% + 5px);
      left: 0;
      overflow: visible;
      padding: 0;
      font-size: 12px;
      line-height: 1.2;
      color: var(--ink);
    }
    .dm-gantt__bar.is-late .dm-gantt__label {
      left: auto;
      right: 0;
      text-align: right;
    }
    .dm-gantt__year:nth-child(even) span {
      display: none;
    }
    .dm-gantt__cert {
      width: calc(var(--size) * 0.6);
      height: calc(var(--size) * 0.6);
    }
    .dm-gantt__cert-count {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dm-gantt__bar,
    .dm-gantt__cert {
      transition: opacity 0.25s ease;
    }
    .dm-gantt__tip {
      animation: none;
    }
  }
</style>
