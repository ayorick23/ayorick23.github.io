---
interface Props {
  index: number;
  title: string;
  description: string;
}

const { index, title, description } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<div class="flex flex-col gap-3 bg-bg px-[26px] pt-[30px] pb-[34px] transition-colors duration-300 ease-out hover:bg-accent-soft">
  <div class="font-mono text-[10px] tracking-[0.14em] text-ink-3">{num}</div>
  <div class="font-display text-[16.5px] leading-[1.3] font-semibold">{title}</div>
  <div class="font-display text-[13.5px] leading-[1.6] text-ink-2">{description}</div>
</div>
