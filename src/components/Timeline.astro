---
import type { TimelineEntry } from "../content/i18n/types";

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;

/* The line sits at the boundary of the 37%/1fr grid columns below, offset by
   half the 56px (gap-x-14) gutter so it lands exactly in the middle of it. */
const linePosition = "md:left-[calc(37%+28px)]";
---

<div data-timeline-root class="relative pl-[26px] md:pl-0">
  <svg data-timeline-svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"></svg>
  {
    entries.map((entry) => (
      // The whole row is the draggable "node" — dragging the dot carries its
      // label along, and the connecting lines follow it, same as a
      // constellation node carries its label and lit edges in the Hero.
      <div data-timeline-node class="relative pb-10">
        <div class:list={["absolute top-[6px] -left-[26px] h-0 w-0", linePosition]}>
          <button
            type="button"
            data-timeline-hit
            aria-hidden="true"
            tabindex="-1"
            class="absolute -top-4 -left-4 h-8 w-8 touch-none cursor-grab rounded-full outline-none active:cursor-grabbing"
          />
          <span
            data-timeline-dot
            class="pointer-events-none absolute -top-[3.5px] -left-[3.5px] block h-[7px] w-[7px] rounded-full border border-accent bg-bg transition-[box-shadow,background-color] duration-200"
            style="box-shadow: 0 0 0 4px var(--accent-soft)"
          />
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] items-start gap-x-8 gap-y-2 md:grid-cols-[37%_1fr] md:gap-x-14">
          <div class="md:text-right">
            <div class="mb-[9px] font-mono text-[11.5px] tracking-[0.1em] text-accent">
              {entry.period}
            </div>
            <div class="font-display text-[17px] font-semibold text-ink">{entry.role}</div>
            {entry.org && <div class="mt-1 font-display text-[13px] text-ink-3">{entry.org}</div>}
          </div>
          <div>
            <p class="mb-3 font-display text-[14px] leading-[1.62] text-ink-2">{entry.description}</p>
            {entry.tags.length > 0 && (
              <div class="flex flex-wrap gap-[6px]">
                {entry.tags.map((tag) => (
                  <span class="rounded-[6px] border border-line px-2 py-[5px] font-mono text-[10.5px] text-ink-3">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  [data-timeline-node].is-active [data-timeline-dot] {
    background-color: var(--accent);
    box-shadow:
      0 0 0 6px var(--accent-soft),
      0 0 16px 1px var(--accent);
  }
</style>

<script>
  import { initTimelineDots } from "../scripts/timeline";
  document.addEventListener("astro:page-load", initTimelineDots);
</script>
