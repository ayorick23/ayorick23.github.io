---
import type { TimelineEntry } from "../content/i18n/types";

interface Props {
  entries: TimelineEntry[];
  /** Shows each entry's short summary instead of the full description (home page). */
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
const startYear = (period: string) => period.match(/\d{4}/)?.[0] ?? "";

/* The line sits at the boundary of the 37%/1fr grid columns below, offset by
   half the 56px (gap-x-14) gutter so it lands exactly in the middle of it. */
const linePosition = "md:left-[calc(37%+28px)]";
---

<div data-timeline-root class="relative pl-[26px] md:pl-0">
  <svg data-timeline-svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"></svg>
  {
    entries.map((entry) => (
      // The whole row is the draggable "node" — dragging the dot carries its
      // label along, and the connecting lines follow it, same as a
      // constellation node carries its label and lit edges in the Hero.
      <div data-timeline-node class:list={["dm-timeline-node relative", compact ? "pb-12" : "pb-14"]}>
        <div class:list={["absolute top-[16px] -left-[26px] h-0 w-0 md:top-[19px]", linePosition]}>
          <button
            type="button"
            data-timeline-hit
            aria-hidden="true"
            tabindex="-1"
            class="absolute -top-4 -left-4 h-8 w-8 touch-none cursor-grab rounded-full outline-none active:cursor-grabbing"
          />
          <span
            data-timeline-dot
            class="dm-timeline-dot pointer-events-none absolute -top-[4px] -left-[4px] block h-[8px] w-[8px] rounded-full border"
          />
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] items-start gap-x-8 gap-y-3 md:grid-cols-[37%_1fr] md:gap-x-14">
          <div class="dm-timeline-text md:text-right">
            <div class="dm-timeline-year">
              <span class="dm-rise">
                <span data-rise>{startYear(entry.period)}</span>
              </span>
            </div>
            <div class="mt-2 font-mono text-[12.5px] tracking-[0.1em] text-accent uppercase">
              <span class="dm-rise">
                <span data-rise>{entry.period}</span>
              </span>
            </div>
          </div>
          <div class="dm-timeline-body md:pt-[3px]">
            <div class="font-display text-[19px] leading-[1.25] font-semibold tracking-[-0.01em] text-ink">{entry.role}</div>
            {entry.org && <div class="mt-1 font-display text-[13.5px] text-ink-3">{entry.org}</div>}
            <p class="mt-3 max-w-[560px] font-display text-[14px] leading-[1.62] text-ink-2">
              {compact ? entry.summary : entry.description}
            </p>
            {!compact && entry.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-[6px]">
                {entry.tags.map((tag) => (
                  <span class="rounded-[6px] border border-line px-2 py-[5px] font-mono text-[10.5px] text-ink-3">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { initTimelineDots } from "../scripts/timeline";
  document.addEventListener("astro:page-load", initTimelineDots);
</script>
