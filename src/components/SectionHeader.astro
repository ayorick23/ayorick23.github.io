---
interface Props {
  kicker: string;
  headingLead: string;
  headingAccent: string;
  id?: string;
  dot?: "accent" | "accent-2";
  align?: "left" | "between";
}

const { kicker, headingLead, headingAccent, id, dot = "accent", align = "left" } = Astro.props;
---

<div
  id={id}
  class:list={[
    "mb-11 flex flex-wrap items-end gap-5",
    align === "between" ? "justify-between" : "flex-col items-start",
  ]}
>
  <div>
    <div class="mb-[18px] flex items-center gap-[9px]">
      <span
        class:list={["h-1 w-1 rounded-full", dot === "accent" ? "bg-accent" : "bg-accent-2"]}
      ></span>
      <span class="font-mono text-[10.5px] tracking-[0.24em] text-ink-2 uppercase">{kicker}</span>
    </div>
    <h2
      class="max-w-xl font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1.14] font-light tracking-[-0.025em]"
    >
      {headingLead} <span class="font-semibold">{headingAccent}</span>
    </h2>
  </div>
  <slot />
</div>
